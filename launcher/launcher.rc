#include "macros.h"
#include "version.h"
#include "product.h"

1 VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,0,0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904E4"
		BEGIN
			VALUE "ProductName", PRODUCT_NAME_A
			VALUE "FileDescription", PRODUCT_TITLE_A
			VALUE "FileVersion", STRINGIFY_A(VER_MAJOR) "." STRINGIFY_A(VER_MINOR)
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
	END
END

id ICON "launcher.ico"
