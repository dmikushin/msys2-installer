#!/usr/bin/env bash

set -e

_thisdir="$( cd "$( dirname "$0" )" && pwd )"
_build="${_thisdir}/_build"
_ifwroot="${_build}/qt-ifw"
_date=$(date +'%Y%m%d')
_dateqif=$(date +'%Y-%m-%d')
_version="${_date}"
_newmsysbase="${_build}/newmsys"
_newmsys="${_newmsysbase}/msys64"

if [ "$MSYSTEM" = "CLANGARM64" ]; then
    _arch_name="arm64"
else
    _arch_name="x86_64"
fi

create_installer_archive() {
  echo "[Creating installer archive...]"

  local _data="${_ifwroot}"/packages/com.msys2.root/data
  pushd / > /dev/null
    mkdir -p "${_data}"
    7z a -mx9 -md128m "${_data}/msys64.7z" "${_newmsys}/"*
  popd > /dev/null
}

create_archives() {
  echo "[Creating tarball...]"
  pushd "${_newmsysbase}" > /dev/null
  /usr/bin/tar --transform='s/:/_/g' --dereference --hard-dereference -cf "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar" msys64
  popd > /dev/null

  echo "[Creating xz archive...]"
  xz -9 --keep --verbose --force --compress --threads=0 "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar"
  xz --test "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar.xz"

  echo "[Creating zstd archive...]"
  zstd -T0 -22 --ultra --force "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar" -o "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar.zst"
  zstd --test "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar.zst"

  rm "${_thisdir}/msys2-base-${_arch_name}-${_date}.tar"
}

create_sfx() {
  echo "[Creating SFX...]"

  pushd "${_newmsysbase}" > /dev/null
    "${_thisdir}/create-sfx.sh" "msys64" "${_thisdir}/msys2-base-${_arch_name}-${_date}.sfx.exe"
  popd > /dev/null
}

copy_installer() {
  echo "[Copying installer...]"
  rm -Rf "${_ifwroot}" && cp -r "${_thisdir}"/qt-ifw "${_ifwroot}"

  find "${_ifwroot}" \( -name "package.xml" -or -name "config.xml" \) -exec sed -i "s|@DATE@|${_dateqif}|g" "{}" \;
  find "${_ifwroot}" \( -name "package.xml" -or -name "config.xml" \) -exec sed -i "s|@VERSION@|${_version}|g" "{}" \;
}

create_installer() {
  echo "[Creating installer...]"

  pushd "${_build}" > /dev/null
    binarycreator \
      -t "$(command -v installerbase)" \
      -p "${_ifwroot}/packages" \
      -c "${_ifwroot}/config/config.xml" \
      --offline-only \
      "${_thisdir}/msys2-${_arch_name}-${_date}.exe" \
      -v
  popd > /dev/null
}

build_custom_packages() {
  echo "[Building custom packages...]"
  local _custom_pkgs="${_build}/custom-packages"
  rm -Rf "${_custom_pkgs}" && mkdir -p "${_custom_pkgs}"

  # Build each PKGBUILD found in packages/
  for _pkgdir in "${_thisdir}"/packages/*/; do
    [ -f "${_pkgdir}/PKGBUILD" ] || continue
    local _pkgname=$(basename "${_pkgdir}")
    echo "  -> Building ${_pkgname}..."
    pushd "${_pkgdir}" > /dev/null
      PKGDEST="${_custom_pkgs}" makepkg -sf --noconfirm
    popd > /dev/null
  done
}

create_custom_repo() {
  echo "[Creating custom package repository...]"
  local _custom_repo="${_build}/custom-repo"
  local _custom_pkgs="${_build}/custom-packages"
  rm -Rf "${_custom_repo}" && mkdir -p "${_custom_repo}"

  # Copy all built packages into the repo directory
  cp "${_custom_pkgs}"/*.pkg.tar.* "${_custom_repo}/" 2>/dev/null || true

  # Also include any pre-built packages placed directly in packages/
  cp "${_thisdir}"/packages/*.pkg.tar.* "${_custom_repo}/" 2>/dev/null || true

  local _pkg_count=$(ls -1 "${_custom_repo}"/*.pkg.tar.* 2>/dev/null | wc -l)
  if [ "${_pkg_count}" -eq 0 ]; then
    echo "  -> No custom packages found, skipping."
    return 1
  fi

  # Create pacman repository database
  repo-add "${_custom_repo}/custom.db.tar.gz" "${_custom_repo}"/*.pkg.tar.*
  echo "  -> Repository created with ${_pkg_count} package(s)."
}

install_custom_packages() {
  echo "[Installing custom packages into chroot...]"
  local _custom_repo="${_build}/custom-repo"
  local _chroot_conf="${_newmsys}/etc/pacman.conf"

  # Append custom repo to the chroot's pacman.conf
  local _repo_path
  _repo_path=$(cygpath -m "${_custom_repo}" 2>/dev/null || echo "${_custom_repo}")
  echo "" >> "${_chroot_conf}"
  echo "[custom]" >> "${_chroot_conf}"
  echo "SigLevel = Never" >> "${_chroot_conf}"
  echo "Server = file:///${_repo_path}" >> "${_chroot_conf}"

  # Sync and install all custom packages
  pacman -Sy --noconfirm --root "${_newmsys}" --config "${_chroot_conf}"
  for _pkg in "${_custom_repo}"/*.pkg.tar.*; do
    [ -f "${_pkg}" ] || continue
    local _pkgname
    _pkgname=$(basename "${_pkg}" | sed 's/-[0-9].*//')
    echo "  -> Installing ${_pkgname}..."
    pacman -S "${_pkgname}" --noconfirm --root "${_newmsys}" --config "${_chroot_conf}"
  done
}

create_chroot_system() {
  echo "[Creating chroot system...]"
  rm -Rf "${_newmsysbase}" && mkdir -p "${_newmsys}"

  pushd "${_newmsys}" > /dev/null
    mkdir -p var/lib/pacman
    mkdir -p var/log
    mkdir -p tmp

    pacman -Syu --root "${_newmsys}"
    pacman -S filesystem msys2-runtime --noconfirm --root "${_newmsys}"
    pacman -S base --noconfirm --root "${_newmsys}"

    # Install custom packages (sillybear, etc.) if available
    if create_custom_repo; then
      install_custom_packages
    fi

    pacman -Q --root "${_newmsys}" > "${_thisdir}/msys2-base-${_arch_name}-${_date}.packages.txt"
  popd > /dev/null
}

main() {
  pacman -S --noconfirm --needed \
    "${MINGW_PACKAGE_PREFIX}-qt-installer-framework" \
    "${MINGW_PACKAGE_PREFIX}-7zip" \
    "${MINGW_PACKAGE_PREFIX}-xz" \
    "${MINGW_PACKAGE_PREFIX}-zstd" \
    "tar"

  # Build custom packages from packages/*/PKGBUILD (if any)
  build_custom_packages

  create_chroot_system

  copy_installer
  create_installer_archive
  create_installer

  if [ "$_arch_name" != "arm64" ]; then
    create_archives
    create_sfx
  fi
}

main